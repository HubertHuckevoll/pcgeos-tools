/*%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 %      Code
 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%*/


/**********************************************************

    MSG_META_IACP_NEW_CONNECTION

    The user has doubleclicked in the NewManager
        System request reaction from the associated geode

 IN:    appLaunchBlock

 **********************************************************/

@method BSQPApplicationClass, MSG_META_IACP_NEW_CONNECTION
{
    AppLaunchBlock  *aplb;
    DiskHandle  dh = 0;
    char        *pB = &fullPath,c;

    // get minimize state
    bqMinimizedState = @call BSQPPrimary::MSG_GEN_DISPLAY_GET_MINIMIZED();
    @callsuper();

    if (appLaunchBlock && (quickMode == BQ_QUICK_OFF))
    {
        aplb = MemLock(appLaunchBlock);
        dh = aplb->ALB_diskHandle;
        dh = FileConstructFullPath(&pB, // pointer to pointer
                                   256,    // Length of buffer
                                   dh, // This can be a disk or
                                   // standard path
                                   aplb->ALB_path,
                                   TRUE);  // Prepend drive name

        strcat(fullPath,"\\");
        strcat(fullPath,aplb->ALB_dataFile);

        // check filename
        c = aplb->ALB_dataFile[0];
        if (c)
        {
            // Display WAV-Name
            @call BSQPPrimary::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(aplb->ALB_dataFile,VUM_NOW);

            // Play File
            BQ_CheckForPlay();
            BQ_StartPlay();
        };
        MemUnlock(appLaunchBlock);
    };
}

/* File selectors have one wildcard mask; use the native final filter for OR. */
static Boolean _pascal BQ_FilterAudio(optr oself, FileEnumCallbackData *dataP,
                                     word frame)
{
    FileAttrs *attrsP;
    char *nameP, *extensionP;

    (void)oself;
    (void)frame;
    attrsP = FileEnumLocateAttr(dataP, FEA_FILE_ATTR, (void *)0);
    if (attrsP && (*attrsP & FA_SUBDIR))
        return FALSE;
    nameP = FileEnumLocateAttr(dataP, FEA_NAME, (void *)0);
    if (!nameP)
        return TRUE;
    extensionP = strrchr(nameP, '.');
    return !extensionP ||
           (LocalCmpStringsNoCase(extensionP, ".WAV", 0) &&
            LocalCmpStringsNoCase(extensionP, ".MP3", 0));
}

@method BQAudioFileSelectorClass, MSG_GEN_FILE_SELECTOR_GET_FILTER_ROUTINE
{
    /* Static storage retains a GEOS virtual code pointer instead of live CS. */
    static GenFileSelectorFilterRoutine *const routineP =
        (GenFileSelectorFilterRoutine *)BQ_FilterAudio;
    static const FileExtAttrDesc attrs[] = {
        { FEA_FILE_ATTR, (void *)0, sizeof(FileAttrs), (void *)0 },
        { FEA_NAME, (void *)0, sizeof(FileLongName), (void *)0 },
        { FEA_END_OF_LIST, (void *)0, 0, (void *)0 }
    };

    filter->filterRoutine = routineP;
    filter->filterAttrs = attrs;
}
