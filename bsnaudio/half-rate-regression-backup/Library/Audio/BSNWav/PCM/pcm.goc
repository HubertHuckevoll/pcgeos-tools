/* Common PCM buffering/conversion. No container parsing or file I/O. */
@define BSNWAV_NO_UI
@include <stdapp.goh>
#include <resource.h>
#include <bsnwav.h>
#include <Ansi/string.h>
@include <bsnwav.goh>
@include "Main/subcode.goh"

#define BSNW_TICKS_PER_SECOND 60
#define BSNW_MIN_TICKS_PER_HALF_BUFFER 2
word peakLevel2;
extern word _far _pascal BSNWAsmStartPlay(void);
#pragma code_seg("PCMCode")

word            simFlags = 0;   // Bit0->Simulating Soundcard
int             playStatus = 0;     // 0 = System ready (default)
                                    // 1 = Playing from File
                                    // 2 = Playing from Memory
int             playStopFlag = 0;   // <>0 --> Abort
dword           playedBytes = 0;    // played Bytes
dword           bytesToPlay = 0;    // Bytes to play
optr            statusGlyphOptr1 = 0;   // 1. col Statusbox
optr            statusGlyphOptr2 = 0;
optr            statusRightBoxOptr = 0;
char            playStatusText[80];
MemHandle       playCacheHandle = NullHandle;
word            playSampleRate = 0;
byte            playChannels = 1;   // channels 1=mono
byte            playBits = 8;       // Bitdepth
word            playMaxRate = 0;    // Rate supported by soundcard
byte            playMaxChannels = 1;    // channels
byte            playMaxBits = 8;    // Bits
byte            konvRateRed = 1;    // Factor Sampleratereduction
byte            konvBitsRed = 1;    // Factor Bitreduction
byte            konvChanRed = 1;    // Factor Channelreduction

byte            *playCachePtr;      // Pointer Playcache
byte            *secondPtr;     // Pointer Secondarybuffer
word            playCacheLen = 8192;    // Length Playcache
word            secBufLen = 8192;   // Length Secondarybuffers
word            secBufLenSoll = 8192;   // requested length Secondarybuffer
word            cacheOffset = 0;    // Offset PlayCache
word            secondOffset = 0;   // Offset Secondbuffer
word            cacheFree = 0;      // Free space in PlayCache
word            cacheFull = 0;      // waiting Bytes in cache
word            cacheKOffset = 0;   // Cacheoffset Reader
word            secondKOffset = 0;  // SecondPointerOffset Reader
word            secondFree = 0;         // Free space in Secondarybuffer
word            secondHandle = 0;   // test purpose only (SecondAlloc)
word            peakLevel = 0;      // signal level (calculated by Konverter)
word            playLen2 = 0;       // needed samples from Cache
// for filling Secondarybufferhalf
Boolean         pcmUnknownLength = FALSE;
word            pcmBlockAlign = 1;
BSNPcmSource    *playSourceP;
Boolean         stereoToggle = FALSE;   // Soundcard toggle Left/Right
word            stereoToggleIni = 0;    // INI-Value

Boolean         compatFlag = FALSE; // TRUE = driver supports "NewWave"
optr            statusBox;
word            secBufL2;
dword           fullLen;
dword           timeOutCounter;
GeodeHandle     attachGeode = 0;

int _pascal BSNWRunPCM(BSNPcmSource *sourceP, word playFlags, optr parent)
{
    int result;
    word configuredCacheLen = playCacheLen;

    playSourceP = sourceP;
    pcmBlockAlign = sourceP->format.blockAlign;
    pcmUnknownLength = (sourceP->pcmBytes == BSN_PCM_LENGTH_UNKNOWN);
    bytesToPlay = sourceP->pcmBytes;
    if (!bytesToPlay)
    {
        playStatus = BSNW_STATUS_OK;
        playSourceP = (void *)0;
        return BSNW_STATUS_OK;
    }
    result = BSNWPrepare(&sourceP->format, playFlags, parent);
    if (result == BSNW_STATUS_OK)
    {
        result = BSNWPlay(&sourceP->format, playFlags, parent);
    }
    else
    {
        /* A failed prepare never reaches BSNWPlay's ordinary cleanup. */
        if (secondPtr)
        {
            (void)BSNWaveStopRecOrPlay(secondPtr);
        }
        if (playCachePtr)
        {
            MemUnlock(playCacheHandle);
            MemFree(playCacheHandle);
            playCachePtr = 0;
        }
        playStatus = BSNW_STATUS_OK;
    }

    /* Short sources shrink the active cache, not the next playback's default. */
    playCacheLen = configuredCacheLen;
    playSourceP = (void *)0;
    return result;
}

int _pascal _export BSNPcmPlay(BSNPcmSource *sourceP, word flags, optr parent)
{
    BSNPcmFormat *formatP;
    word align;
    int result;

    if (!sourceP || !sourceP->readP)
        return BSNW_SOURCE_ERROR;
    formatP = &sourceP->format;
    if ((formatP->channels != 1 && formatP->channels != 2) ||
        (formatP->bitsPerSample != 8 && formatP->bitsPerSample != 16) ||
        formatP->sampleRate <= 5000 || formatP->sampleRate >= 44200)
        return BSNW_UNKNOWN_WAVE_FORMAT;
    align = formatP->channels * (formatP->bitsPerSample / 8);
    if (formatP->blockAlign != align ||
        formatP->avgBytesPerSecond != formatP->sampleRate * align ||
        (sourceP->pcmBytes != BSN_PCM_LENGTH_UNKNOWN &&
         sourceP->pcmBytes % align))
        return BSNW_UNKNOWN_WAVE_FORMAT;
    result = BSNWPreCheck(flags);
    if (result != BSNW_STATUS_OK || (flags & BSNW_TEST_ONLY))
        return result;
    playStatus = BSNW_STATUS_PLAY_MEM;
    return BSNWRunPCM(sourceP, flags, parent);
}

typedef word _pascal BSNPcmReadCall(void *contextP, void *destP,
                                  word capacity, BSNPcmReadProc *readerP);

word _pascal BSNWReadPCM(void *dest, word requested)
{
    return ((BSNPcmReadCall *)ProcCallFixedOrMovable_pascal)(
        playSourceP->contextP, dest, requested, playSourceP->readP);
}

static word BSNWDetermineSecondaryBufferLength(const BSNPcmFormat *fmt,
                                               word configuredLength)
{
    dword avgRate;
    dword minHalfBytes;
    dword requiredLen;
    word computedLen;

    avgRate = fmt->avgBytesPerSecond;
    if (avgRate == 0)
    {
        return configuredLength;
    }

    /* Round up: each usable half must hold at least two ticks of audio. */
    minHalfBytes = avgRate * BSNW_MIN_TICKS_PER_HALF_BUFFER;
    minHalfBytes = (minHalfBytes + (BSNW_TICKS_PER_SECOND - 1))
                   / BSNW_TICKS_PER_SECOND;
    if (minHalfBytes < 256)
    {
        minHalfBytes = 256;
    }

    /* At a 64K boundary, the driver keeps the larger part of the block.
     * It can also skip 16 bytes. Request twice the usable buffer size,
     * plus those 16 bytes, to keep two full halves after this reduction.
     */
    requiredLen = (minHalfBytes << 2) + 16;
    if (requiredLen > 0x0000FFF8UL)
    {
        requiredLen = 0x0000FFF8UL;
    }

    /* Eight-byte alignment also aligns each half to a stereo PCM frame. */
    computedLen = (word)requiredLen;
    computedLen = (word)((computedLen + 7) & ~7);
    if (computedLen < 512)
    {
        computedLen = 512;
    }

    if (configuredLength >= computedLen)
    {
        return configuredLength;
    }
    return computedLen;
}

int _pascal BSNWLoadData(void *cachePtr, void *secPtr)
{
    int respond = BSNW_STATUS_OK;
    dword wanted;
    word quantum;

    quantum = pcmBlockAlign * konvRateRed;

    // read from source until buffer is filled
    // or the source go out of data
    while ( (secondFree) && (respond == BSNW_STATUS_OK) )
    {
        /* Decode only enough source data for this output refill. Filling
         * all free cache space first can decode extra MP3 frames while DMA
         * waits. Keep whole rate-reduction groups so short reads cannot
         * lose samples at a cache boundary.
         */
        wanted = (dword)secondFree * konvRateRed * konvBitsRed * konvChanRed;
        wanted += quantum - 1;
        wanted -= wanted % quantum;
        if (wanted > playCacheLen)
            wanted = playCacheLen;
        while (cacheFull < wanted && cacheFree >= pcmBlockAlign && bytesToPlay)
        {
            respond = BSNWLoadCache(cachePtr);
            if (respond != BSNW_STATUS_OK)
            {
                return respond;
            }
            // bytesToPlay,cacheFull will be updated
        };

        // Cachedata --> Konverter --> Secondarybuffer
        if (cacheFull)
        {
            // Konvert Cachedata
            if (konvBitsRed == 1)
            {
                // no reduction of bitdepth
                BSNWKonvertData(cachePtr,secPtr);
            }
            else
            {
                // 16 --> 8 Bit
                BSNWKonvert16To8(cachePtr,secPtr);
            }
        }
        else
        {
            // Source is out of data
            // fill with silence
            BSNWFillSilence(secPtr,secondFree);
            respond = BSNW_PLAY_FINISHED;
        };
    };

    // End
    return (respond);
}

int _pascal BSNWLoadCache(void *cachePtr)
{
    word request;
    word received;
    byte *dest;

    if (!cacheFree || !bytesToPlay)
    {
        return BSNW_STATUS_OK;
    }

    request = cacheFree;
    if (!pcmUnknownLength && (bytesToPlay < (dword)request))
    {
        request = (word)bytesToPlay;
    }
    if (request > (word)(playCacheLen - cacheOffset))
    {
        request = playCacheLen - cacheOffset;
    }

    /* Never ask a PCM decoder for a fractional sample frame. */
    if (pcmBlockAlign)
    {
        request = (word)(request - (request % pcmBlockAlign));
        if (!request)
        {
            return BSNW_SOURCE_ERROR;
        }
    }

    dest = (byte *)cachePtr + cacheOffset;
    received = BSNWReadPCM(dest, request);
    if (received == BSNW_PCM_READ_ERROR || received > request)
    {
        return BSNW_SOURCE_ERROR;
    }
    if (!received)
    {
        /* EOF can precede an estimated length without losing the tail. */
        if (!pcmUnknownLength)
        {
            fullLen -= bytesToPlay;
        }
        bytesToPlay = 0;
        return BSNW_STATUS_OK;
    }
    if (received % pcmBlockAlign)
    {
        return BSNW_SOURCE_ERROR;
    }

    /* ATTENTION: Playback counters support less than 4 GiB of PCM/session.
     * Widen the accounting before accepting longer unknown-length streams.
     */
    if (pcmUnknownLength && fullLen > 0xfffffffeUL - received)
        return BSNW_SOURCE_ERROR;

    cacheOffset += received;
    if (cacheOffset >= playCacheLen)
    {
        cacheOffset = 0;
    }
    cacheFree -= received;
    cacheFull += received;
    if (pcmUnknownLength)
    {
        fullLen += (dword)received;
    }
    else
    {
        bytesToPlay -= (dword)received;
    }
    return BSNW_STATUS_OK;
}

void _pascal BSNWFillSilence(void *secPtr, word len)
{
    byte    *ptr;
    byte    fill;

    // test pointer
    if (secPtr)
    {
        if (playBits==16)
        {
            fill = 0;
        }
        else
        {
            fill = 0x80;
        };

        ptr = secPtr;
        ptr = ptr + secondKOffset;

        while (len && secondFree)
        {
            // silence
            *ptr = fill;

            // Pointer to next sample
            ptr++;
            len--;
            secondFree--;
            secondKOffset++;

            if (secondKOffset>=secBufLen)
            {
                ptr = secPtr;
                secondKOffset = 0;
            };
        };
    };
}

void _pascal BSNWKonvertData(byte *cachePtr, byte *secPtr)
{
    byte    *dest;
    byte    *src;
    byte    b;
    word    sample;
    dword   level = 0;
    dword   div = 0;
    int i;

    dest = secPtr + secondKOffset;
    src =  cachePtr  + cacheKOffset;
    b = 0x80;

    while ( (cacheFull) && (secondFree) )
    {
        // 1:1
        sample = (word)(*src);

        // Stereo --> Mono
        if (konvChanRed>1)
        {
            // Pointer / Counter
            src++;
            cacheFull--;
            cacheFree++;
            cacheKOffset++;

            if (cacheKOffset>=playCacheLen)
            {
                cacheKOffset = 0;
                src =  cachePtr;
            };

            sample = (sample + (word)(*src)) / 2;
        };

        // Sample -> Buffer
        *dest = (byte)sample;

        // Peak level
        if (playBits == 16)
        {
            // 16 Bit -> ignore lower Byte of Sample for peakLevel
            if (0!=(cacheKOffset & 1))
            {
                // only positiv 16 Bit signed values
                if ((byte)sample < 0x80)
                {
                    sample = sample + 0x80;
                    if ( ((byte)sample) > b)
                    {
                        b = (byte)sample;
                    };
                };
            };
        }
        else
        {
            // 8 Bit
            // Compare level with peaklevel

            if ((byte)sample > b)
            {
                b = (byte)sample;
            };

        };

        // Destination pointer
        dest++;
        secondFree--;
        secondKOffset++;
        if (secondKOffset>=secBufLen)
        {
            secondKOffset = 0;
            dest = secPtr;
        };

        // Sourcepointer to next sample
        /* Keep interleaved channels together when reducing the rate. */
        i = 1;
        if ((cacheKOffset + 1) % pcmBlockAlign == 0)
            i += (konvRateRed - 1) * pcmBlockAlign;

        while(i && cacheFull)
        {

            src++;
            cacheFull--;
            cacheFree++;
            cacheKOffset++;
            if (cacheKOffset>=playCacheLen)
            {
                cacheKOffset = 0;
                src =  cachePtr;
            };
            i--;
        };
    };

    // signal level
    peakLevel2 = (word)(b - 0x80);
    peakLevel = peakLevel2;
}

void _pascal BSNWKonvert16To8(void *cachePtr, void *secPtr)
{
    byte    *dest;
    byte    b,bs;
    int *src;
    long    sample;
    int i;

    dest = secPtr;
    src =  cachePtr;
    dest = dest + secondKOffset;
    src =  src  + (cacheKOffset>>1);
    b = 0x80;

    while ( (cacheFull) && (secondFree) )
    {
        // read 16 Bit
        sample = (long)(*src);

        // Stereo -> Mono
        if (konvChanRed>1)
        {
            src++;
            cacheFull--;
            cacheFree++;
            cacheKOffset++;
            cacheFull--;
            cacheFree++;
            cacheKOffset++;

            if (cacheKOffset>=playCacheLen)
            {
                cacheKOffset = 0;
                src =  cachePtr;
            };

            sample = (sample + (long)(*src)) / 2;
        };

        // 16 --> 8
        bs = (byte)(0x80 + (byte)(sample>>8));
        *dest = bs;

        // peak level
        if (bs > b)
            b = bs;

        // Dest-pointer
        dest++;
        secondFree--;
        secondKOffset++;
        if (secondKOffset>=secBufLen)
        {
            secondKOffset = 0;
            dest = secPtr;
        };

        // Sourcepointer to next sample
        /* Skip whole source frames only after their final channel. */
        i = 1;
        if ((cacheKOffset + 2) % pcmBlockAlign == 0)
            i += (konvRateRed - 1) * (pcmBlockAlign / 2);

        while(i && cacheFull)
        {

            src++;
            cacheFull--;
            cacheFree++;
            cacheKOffset++;
            cacheFull--;
            cacheFree++;
            cacheKOffset++;
            if (cacheKOffset>=playCacheLen)
            {
                cacheKOffset = 0;
                src =  cachePtr;
            };
            i--;
        };
    };

    // peak level (7 Bit)
    peakLevel2 = (word)(b - 0x80);
    peakLevel = peakLevel2;
}

int _pascal BSNWPrepare(BSNPcmFormat *bfc,word playFlags,optr parent)
{
    int respond = 0;
    word    bits,rate;
    word    konvertFaktor;
    char    *ptr;
    word    size;
    word    secBufRequest;

    // Delete Flags
    playStopFlag = FALSE;
    statusBox = 0;
    respond = BSNW_STATUS_OK;
    playCachePtr = 0;
    secondPtr = 0;          // Pointer Secondarybuffer
    fullLen = 0;
    timeOutCounter = 0;

    // Prepare UI (Statusbox) if:
    if ( (playFlags & BSNW_SHOW_STATUS) // 1. requested
            && (parent != NullOptr))        // 2. parent-obj defined
    {
        // Attach Statusbox to Tree and enable
        statusBox = BSCNCreateStatusBox(parent);
    }
    else
    {
        // no UI
        statusGlyphOptr1 = 0;
        statusGlyphOptr2 = 0;
        statusRightBoxOptr = 0;
    };

    // Allocate Playcache if:
    if ( respond == BSNW_STATUS_OK )    // 1. Soundcard is ready
    {
        // Allocate Playcache

        // Optimize buffersize
        if (bytesToPlay>(dword)playCacheLen)
        {
            size = playCacheLen;
        }
        else
        {
            size = (word)bytesToPlay;
        };

        size -= size % pcmBlockAlign;
        if (!size)
            return BSNW_SOURCE_ERROR;
        playCachePtr = BSNWAllocPlayCache(size);
        /* Cache capacity must match the allocation, including short WAVs. */
        cacheFree    = size;
        cacheFull    = 0;
        playCacheLen = size;
    }
    else
    {
        // No Secondarybuffer --> No Playcache
        playCachePtr = 0;
    };


    // Prepare Soundcard

    if (playCachePtr)
    {
        // Playcache OK

        // Prepare Konverter / Soundcard
        respond = BSNWPrepKS((word)bfc->sampleRate,
                             (byte)bfc->channels,
                             (byte)bfc->bitsPerSample);
    }
    else
    {
        // Playcache not valid
        respond = BSNW_MEMORY_ERROR;
    };

    // Display WAV-Parameters
    if (statusGlyphOptr1)
    {

        @ifndef BSNWAV_NO_UI

        rate = (word)(bfc->sampleRate);
        bits = (word)(bfc->bitsPerSample);

        ptr = playStatusText;
        konvertFaktor = (konvRateRed * konvBitsRed * konvChanRed);

        if (konvertFaktor>1)
        {
            // if konverting --> []
            *ptr = '[';
            ptr++;
        };

        if (bfc->channels == 1)
        {
            sprintf(ptr,"%uHz - %uBit - Mono",rate,bits);
            // Mono --> Disable right Speaker
            @send statusRightBoxOptr::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
        }
        else
        {
            sprintf(ptr,"%uHz - %uBit - Stereo",rate,bits);
        };

        if (konvertFaktor>1)
        {
            strcat(playStatusText,"]");
        };

        @call statusGlyphOptr1::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(playStatusText,VUM_DELAYED_VIA_UI_QUEUE); /**/

        @endif

    };

    // Allocating Secondbuffer

    if (respond == BSNW_STATUS_OK)
    {
        // Allocate Secondarybuffer
        secBufRequest = BSNWDetermineSecondaryBufferLength(bfc, secBufLenSoll);
        secBufLen  = BSNWAllocSecBuffer(&secondPtr,secBufRequest);
        secBufL2   = secBufLen>>1;      // halbe Pufferl�nge
        secondFree = secBufLen;
        if (!secBufLen || !secondPtr)
        {
            respond = BSNW_MEMORY_ERROR;
        }
    };

    if (respond == BSNW_STATUS_OK)
    {
        size = pcmBlockAlign * konvRateRed;
        if (playCacheLen >= size)
        {
            playCacheLen -= playCacheLen % size;
            cacheFree = playCacheLen;
        }
    }

    playLen2     = secBufL2 * konvRateRed * konvBitsRed * konvChanRed;
    fullLen      = pcmUnknownLength ? 0 : bytesToPlay;
    playedBytes  = 0;
    secondOffset = 0;
    cacheOffset  = 0;
    secondKOffset= 0;
    cacheKOffset = 0;

    // Toggle channels if :
    if (secondPtr &&
        ((stereoToggle && (stereoToggleIni==0)) ||
         (!stereoToggle && (stereoToggleIni >0))))
    {
        BSNWInsertSample(secondPtr,playBits);
    };

    return (respond);
};

/***********************************************************************
 *
 * ROUTINE:     BSNWPlay
 * DESCRIPTION: Play PCM with one temporary buffer for all refills.
 * PARAMETERS:  Source format, playback flags, and optional status parent.
 * STRATEGY:    Read and convert outside DMA memory. Select the free half
 *              after reading. Keep the refill if an IRQ occurs during
 *              its copy. Count source bytes only after their half plays.
 * KNOWN BUGS/SIDE EFFECTS/CAVEATS/IDEAS:
 *              A missed deadline can cause silence or repeat part of a
 *              refill. Keep the prepared data so it is not skipped.
 * REVISION HISTORY:
 *      Name    Date        Description
 *      ----    ----        -----------
 *      Codex   11/04/26    Prepare refills and recover after missed deadlines
 *
 ***********************************************************************/
int _pascal BSNWPlay(BSNPcmFormat *bfc, word playFlags, optr parent)
{
    int respond = BSNW_STATUS_OK;
    dword i;
    word aiState, aiState2, advance, half;
    /* These counts use source bytes, before rate or format conversion. */
    dword queued[2], converted, refillBytes;
    dword newSec, lastSec = 0;
    MemHandle refillH;
    byte *refillP;
    Boolean refillReady = FALSE; /* TRUE until the DMA copy succeeds. */

    peakLevel2 = 0;
    /* Allocate and lock once, before DMA starts. A slow source must write
     * here instead of a DMA half which can become active during the read.
     */
    refillH = MemAlloc(secBufL2, HF_SWAPABLE, HAF_ZERO_INIT);
    refillP = refillH ? MemLock(refillH) : (void *)0;
    if (!refillP)
        respond = BSNW_MEMORY_ERROR;
    else
    {
        /* Measure each initial half separately. A channel-toggle sample
         * uses output space but contains no source data. With rate
         * reduction, the two halves can consume different source lengths.
         */
        secondFree = secBufL2 - secondOffset;
        respond = BSNWLoadData(playCachePtr, secondPtr);
        /* Remove unread and cached bytes to count converted source bytes.
         * For an unknown length, fullLen counts bytes read so far;
         * bytesToPlay can still contain the unknown-length marker.
         */
        queued[0] = fullLen - cacheFull;
        if (!pcmUnknownLength)
            queued[0] -= bytesToPlay;
        if (respond == BSNW_STATUS_OK || respond == BSNW_PLAY_FINISHED)
        {
            secondFree = secBufL2;
            secondKOffset = secBufL2;
            respond = BSNWLoadData(playCachePtr, secondPtr);
            queued[1] = fullLen - cacheFull - queued[0];
            if (!pcmUnknownLength)
                queued[1] -= bytesToPlay;
        }
    }
    /* EOF means that reading is done. The prepared halves must still play. */
    if (respond == BSNW_PLAY_FINISHED)
        respond = BSNW_STATUS_OK;
    if (respond == BSNW_STATUS_OK)
    {
        secondOffset = 0;
        if (BSNWAsmStartPlay())
            respond = BSNW_HARDWARE_NOT_READY;
        /* Both drivers reset the count and half to zero at start. Keep
         * this baseline so an IRQ during the option call is still counted.
         * The high byte requests an option write. Bit 0 of the low byte
         * enables clearing of completed DMA halves.
         */
        aiState2 = 0;
        (void)BSNWaveGetAIState(0xFF01);
        i = 0;

        while (respond == BSNW_STATUS_OK)
        {
            if (playStopFlag)
            {
                respond = BSNW_ABORT;
                break;
            }
            /* Simulation has no IRQ: advance the byte count and swap halves. */
            if (simFlags)
                aiState = (byte)(aiState2 + 1) |
                          ((aiState2 ^ 0x0100) & 0x0100);
            else
                aiState = BSNWaveGetAIState(0);
            /* A nonzero high byte means the lower half is free. */
            half = (aiState & 0xFF00) ? 0 : 1;
            if (aiState != aiState2)
            {
                /* Cast to byte so 255 -> 0 counts as one IRQ.
                 * ATTENTION: This byte cannot count a full cycle of 256
                 * IRQs between reads. Use a wider driver counter if needed.
                 */
                advance = (byte)(aiState - aiState2);
                /* An IRQ with a refill still ready means its copy is late. */
                if (advance != 1 || refillReady)
                    timeOutCounter++;
                if (advance == 1)
                {
                    playedBytes += queued[half];
                    queued[half] = 0;
                }
                else
                {
                    /* At least two halves passed. Count each queued source
                     * block once; later empty halves contain only silence.
                     */
                    playedBytes += queued[0] + queued[1];
                    queued[0] = queued[1] = 0;
                }
                aiState2 = aiState;
            }
            else if (!refillReady)
            {
                TimerSleep(1);
                continue;
            }

            /* EOF alone is not enough. Also wait for the last DMA half
             * and for any prepared refill which is not yet in DMA memory.
             */
            if (!refillReady && !bytesToPlay && !cacheFull &&
                !queued[0] && !queued[1])
            {
                respond = BSNW_PLAY_FINISHED;
                break;
            }
            if (!refillReady)
            {
                if (!bytesToPlay && !cacheFull)
                    continue;
                /* Save the converted count before reading. Its increase
                 * gives the source length of this refill, without silence.
                 */
                converted = fullLen - cacheFull;
                if (!pcmUnknownLength)
                    converted -= bytesToPlay;
                /* Reuse the converter with one half of temporary space.
                 * Offset zero and this limit keep all writes in that half.
                 */
                secondFree = secBufL2;
                secondKOffset = 0;
                respond = BSNWLoadData(playCachePtr, refillP);
                if (respond != BSNW_STATUS_OK &&
                    respond != BSNW_PLAY_FINISHED)
                    break;
                respond = BSNW_STATUS_OK;
                refillBytes = fullLen - cacheFull - converted;
                if (!pcmUnknownLength)
                    refillBytes -= bytesToPlay;
                refillReady = (refillBytes != 0);
                /* Reading or decoding can wait on files or the heap.
                 * Read the DMA state again before choosing a destination.
                 */
                continue;
            }

            memcpy(secondPtr + half * secBufL2, refillP, secBufL2);
            if (!simFlags && BSNWaveGetAIState(0) != aiState2)
            {
                /* DMA reached another half during the copy or state call.
                 * Keep the prepared data and retry in the current free half.
                 * The source can be a decoder which cannot read backwards.
                 */
                continue;
            }
            /* Record this source length only after a copy with no new IRQ. */
            queued[half] = refillBytes;
            refillReady = FALSE;

            ////////////// Display if: /////////////

            if ( (statusGlyphOptr2)         // 1. requested
                    && (secondFree == 0)        // 2. Buffers are filled
                    && ((i&0x001F) == 0x0007)   )   // 3. 8th loop
            {
                newSec = BSNWaveCalcPlaytimeText(playStatusText,playedBytes,fullLen,bfc->avgBytesPerSecond,BSCPT_REST_TIME);
                if ( (newSec != lastSec)    // 4. new SECOND or
                        || (newSec < 5 ) )      //    SECOND lower 5
                {
                    @ifndef BSNWAV_NO_UI
                    @send statusGlyphOptr2::MSG_GEN_REPLACE_VIS_MONIKER_TEXT(playStatusText,VUM_DELAYED_VIA_UI_QUEUE);
                    @endif
                    lastSec = newSec;
                };
            };

            if (simFlags)
                TimerSleep(5);

            /////////// Check Abort condition /////////////

            // Stopflag (Abort by user)
            if (playStopFlag)
            {
                respond = BSNW_ABORT;
            };

            i++;        // loopcounter
        };
    };

////////////// END ///////////////////////

    // Stop soundcard/DMA and free Secondarybuffer
    // (driver will do this jobs)
    BSNWaveStopRecOrPlay(secondPtr);
    /* Release the extra block on success, abort, and all error paths. */
    if (refillH)
    {
        MemUnlock(refillH);
        MemFree(refillH);
    }

    if (respond == BSNW_PLAY_FINISHED)
    {
        // BSNW_PLAY_FINISHED is only for internal use
        // must be replaced with BSNW_STATUS_OK
        respond = BSNW_STATUS_OK;
    };

    // Free Playcache
    if (playCachePtr)
    {
        if(secondHandle)
        {
            // Simulated Secondarybuffer (NT Target)
            MemUnlock(secondHandle);
            MemFree(secondHandle);
        };

        MemUnlock(playCacheHandle);
        MemFree(playCacheHandle);
    };

    @ifndef BSNWAV_NO_UI
    // Disable Statusbox and remove from tree if:
    if (    (playFlags &  BSNW_SHOW_STATUS) // 1. Display was visible
            && (parent    != NullOptr)     // 2. parent was defined
            && (statusBox != NullOptr) )   // 3. statusBox was defined
    {
        @call statusBox::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
        @call parent::MSG_GEN_REMOVE_CHILD(statusBox,0);
        @call statusBox::MSG_META_BLOCK_FREE();
    };
    @endif

    // reset internal state
    playStatus = BSNW_STATUS_OK;

    return (respond);
}
