/* File-backed pull adapter; compressed input stays in the decoder's buffer. */
#include "mp3int.h"
#include <bsnwav.h>
#ifdef __WATCOMC__
#pragma code_seg("MP3ReaderCode")
#endif

static word _pascal BSNMP3Read(BSNMP3Dec *mp3P, void *destP, word maxBytes,
                               Boolean probe)
{
    Mp3DecFormat format;
    Mp3DecResult result;
    Mp3Decoder *decoderP;
    byte *inputP;
    word frames, capacity, count, recoveries;

    recoveries = 0;
    for (;;) {
        result = Mp3DecReadPCM(mp3P->decoderH, destP, maxBytes, &frames, &format);
        if (result == MP3DEC_FORMAT_CHANGED ||
            (format.channels && mp3P->source.format.channels &&
             (format.channels != mp3P->source.format.channels ||
              format.sampleRate != mp3P->source.format.sampleRate))) {
            mp3P->status = BSNW_UNKNOWN_WAVE_FORMAT;
            return BSN_PCM_READ_ERROR;
        }
        if (result == MP3DEC_RECOVERABLE)
            mp3P->damaged = TRUE;
        if (frames) {
            if (result != MP3DEC_PCM && result != MP3DEC_RECOVERABLE)
                break;
            return frames * format.channels * 2;
        }
        if (result == MP3DEC_OUTPUT_SMALL) {
            if (!probe || !format.channels)
                break;
            mp3P->source.format.sampleRate = format.sampleRate;
            mp3P->source.format.channels = format.channels;
            mp3P->source.format.bitsPerSample = 16;
            mp3P->source.format.blockAlign = format.channels * 2;
            mp3P->source.format.avgBytesPerSecond =
                format.sampleRate * format.channels * 2;
            return 0;
        }
        if (result == MP3DEC_END) {
            if (probe) break; /* Empty/non-audio input has no PCM format. */
            return 0;
        }
        if (result == MP3DEC_RECOVERABLE) {
            /* ATTENTION: At most 64 damaged-frame/sync recoveries per call.
             * Longer damaged regions need an incremental recovery API.
             */
            if (++recoveries > 64) break;
            continue;
        }
        if (result != MP3DEC_NEED_INPUT)
            break;
        decoderP = MemLock(mp3P->decoderH);
        capacity = MP3_INPUT_SIZE - decoderP->used;
        if (!capacity || decoderP->ended) {
            MemUnlock(mp3P->decoderH);
            break; /* Decoder cannot make input progress. */
        }
        inputP = MemLock(decoderP->inputH);
        /* Read directly into owned free space: every read byte is accepted,
         * so no INPUT_FULL suffix or caller-side compressed buffer exists.
         */
        count = FileRead(mp3P->file, inputP + decoderP->used, capacity, FALSE);
        MemUnlock(decoderP->inputH);
        if (count <= capacity) {
            decoderP->used += count;
            if (!count) decoderP->ended = 1;
        }
        MemUnlock(mp3P->decoderH);
        if (count > capacity) break; /* FileRead returns 0xffff on error. */
    }
    mp3P->status = BSNW_SOURCE_ERROR;
    return BSN_PCM_READ_ERROR;
}

int _pascal _export BSNMP3DecOpen(BSNMP3Dec *mp3P, FileHandle file)
{
    return BSNMP3DecOpenEx(mp3P, file, 0);
}

/***********************************************************************
 * ROUTINE:     BSNMP3DecOpenEx
 * DESCRIPTION: Open an MP3 with a fixed output-quality option.
 * PARAMETERS:  Caller context, borrowed file, and BSN_MP3_HALF_RATE or zero.
 * STRATEGY:    Set the option before the probe retains the first PCM frame.
 * KNOWN BUGS/SIDE EFFECTS/CAVEATS/IDEAS:
 *              Half rate reduces high-frequency detail. It does not change
 *              duration, pitch, channel count, or the caller context layout.
 * REVISION HISTORY:
 *      Codex/MeyerK  11/04/26  Initial version
 ***********************************************************************/
int _pascal _export BSNMP3DecOpenEx(BSNMP3Dec *mp3P, FileHandle file,
                                   word options)
{
    Mp3DecResult result;
    Mp3Decoder *decoderP;
    word count;
    int status;

    if (!mp3P)
        return BSNW_SOURCE_ERROR;
    memset(mp3P, 0, sizeof(*mp3P));
    if ((options & ~BSN_MP3_HALF_RATE) ||
        !file || FilePos(file, 0, FILE_POS_START) != 0)
        return BSNW_SOURCE_ERROR;
    result = Mp3DecCreate(&mp3P->decoderH);
    if (result != MP3DEC_PCM)
        return result == MP3DEC_NO_MEMORY ? BSNW_MEMORY_ERROR : BSNW_SOURCE_ERROR;
    decoderP = MemLock(mp3P->decoderH);
    decoderP->halfRate = (options & BSN_MP3_HALF_RATE) != 0;
    decoderP->ext.halfRate = decoderP->halfRate;
    MemUnlock(mp3P->decoderH);
    mp3P->file = file;
    count = BSNMP3Read(mp3P, (void *)0, 0, TRUE);
    if (count == BSN_PCM_READ_ERROR) {
        status = mp3P->status;
        BSNMP3DecClose(mp3P);
        return status;
    }
    mp3P->source.pcmBytes = BSN_PCM_LENGTH_UNKNOWN;
    mp3P->source.contextP = mp3P;
    mp3P->source.readP = BSNMP3DecReadPCM;
    return BSNW_STATUS_OK;
}

word _pascal _export BSNMP3DecReadPCM(void *contextP, void *destP, word maxBytes)
{
    BSNMP3Dec *mp3P;

    mp3P = contextP;
    if (!mp3P || !mp3P->decoderH || mp3P->status || !destP ||
        maxBytes < mp3P->source.format.blockAlign)
        return BSN_PCM_READ_ERROR;
    return BSNMP3Read(mp3P, destP, maxBytes, FALSE);
}

void _pascal _export BSNMP3DecClose(BSNMP3Dec *mp3P)
{
    if (mp3P) {
        Mp3DecDestroy(mp3P->decoderH);
        mp3P->decoderH = NullHandle;
        mp3P->file = 0;
        mp3P->source.readP = (void *)0;
        mp3P->source.contextP = (void *)0;
    }
}
